{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NLP-refinement Acceptance Trace v5",
  "type": "object",
  "required": ["schema_version", "trace_id", "run_id", "user_outcome", "invariant_id", "acceptance_criterion_id", "evidence_refs", "result"],
  "properties": {
    "schema_version": {"const": "5.0"},
    "trace_id": {"type": "string", "pattern": "^AT-[0-9]{3,8}$"},
    "run_id": {"type": "string", "pattern": "^run_[a-z0-9]{12,64}$"},
    "user_outcome": {"type": "string", "minLength": 1},
    "invariant_id": {"type": "string", "minLength": 1},
    "acceptance_criterion_id": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "result": {"type": "string", "enum": ["passed", "failed", "not-run", "blocked"]}
  },
  "additionalProperties": false
}
