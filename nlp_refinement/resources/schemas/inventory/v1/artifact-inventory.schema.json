{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NLP-refinement Artifact Inventory v1",
  "type": "object",
  "required": ["schema_version", "scan_status", "inventory_id", "inventory_hash", "candidates", "excluded"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scan_status": {"const": "complete"},
    "inventory_id": {"type": "string", "pattern": "^inv_[a-f0-9]{24}$"},
    "inventory_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relative_path", "artifact_type", "byte_count", "sha256", "utf8_status", "format_status"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "enum": ["markdown", "json", "toml", "yaml"]},
          "byte_count": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "utf8_status": {"const": "valid"},
          "format_status": {"type": "string", "enum": ["valid", "invalid", "unvalidated", "not-applicable"]}
        },
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relative_path", "reason"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
