{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NLP-refinement Phase Envelope v4",
  "type": "object",
  "required": ["schema_version", "run_id", "expected_revision", "phase_name", "input_artifact_refs", "target_snapshot_hash", "allowed_reads", "allowed_writes", "required_output_schema"],
  "properties": {
    "schema_version": {"const": "4.0"},
    "run_id": {"type": "string", "pattern": "^run_[a-z0-9]{12,64}$"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "phase_name": {"type": "string", "enum": ["review", "triage", "repair", "verify", "rereview", "integrity"]},
    "input_artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "target_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "allowed_reads": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "allowed_writes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_output_schema": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
